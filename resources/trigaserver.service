[Unit]
Description=TrigaServer
After=network.target

[Service]
EnvironmentFile=/etc/trigaserver.conf
ExecStart=${CMAKE_INSTALL_BIN}/usr/local/bin/trigaserver --SPU_CHA $SPU_CHA --SPU_CHB $SPU_CHB --PLC_ADRESS $PLC_ADRESS --PLC_CONV_FILE $PLC_CONV_FILE --PORT_CSV $PORT_CSV --INTERVAL_ERROR_SPU $INTERVAL_ERROR_SPU --INTERVAL_ERROR_PLC $INTERVAL_ERROR_PLC --PJI_Poco $PJI_Poco --PJI_EntPri $PJI_EntPri --PJI_SaiPri $PJI_SaiPri --PJI_EntSec $PJI_EntSec --PJI_SaiSec $PJI_SaiSec --PJI_Poco_ADDR $PJI_Poco_ADDR --PJI_EntPri_ADDR $PJI_EntPri_ADDR --PJI_SaiPri_ADDR $PJI_SaiPri_ADDR --PJI_EntSec_ADDR $PJI_EntSec_ADDR --PJI_SaiSec_ADDR $PJI_SaiSec_ADDR --INTERVAL_ERROR_PJI $INTERVAL_ERROR_PJI --N1500FT_VasPri $N1500FT_VasPri --N1500FT_VasPri_ADDR $N1500FT_VasPri_ADDR --N1500FT_VasPri_BAUD $N1500FT_VasPri_BAUD --N1500FT_VasPri_PARITY $N1500FT_VasPri_PARITY --INTERVAL_ERROR_N1500FT $INTERVAL_ERROR_N1500FT --INTERVAL_MONITOR $INTERVAL_MONITOR
Restart=always
User=trigauser

[Install]
WantedBy=multi-user.target
