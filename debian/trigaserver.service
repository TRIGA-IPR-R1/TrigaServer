[Unit]
Description=TrigaServer
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/trigaserver.conf
ExecStart=/usr/bin/trigaserver --SPU_CHA $SPU_CHA --SPU_CHB $SPU_CHB --PLC_ADRESS $PLC_ADRESS --PLC_CONV_FILE $PLC_CONV_FILE --PORT_CSV $PORT_CSV --INTERVAL_ERROR_SPU $INTERVAL_ERROR_SPU --INTERVAL_ERROR_PLC $INTERVAL_ERROR_PLC --PJI_Poco $PJI_Poco --PJI_EntPri $PJI_EntPri --PJI_SaiPri $PJI_SaiPri --PJI_EntSec $PJI_EntSec --PJI_SaiSec $PJI_SaiSec --PJI_Poco_ADDR $PJI_Poco_ADDR --PJI_EntPri_ADDR $PJI_EntPri_ADDR --PJI_SaiPri_ADDR $PJI_SaiPri_ADDR --PJI_EntSec_ADDR $PJI_EntSec_ADDR --PJI_SaiSec_ADDR $PJI_SaiSec_ADDR --INTERVAL_ERROR_PJI $INTERVAL_ERROR_PJI --INTERVAL_MONITOR $INTERVAL_MONITOR
Restart=always
User=trigauser
Group=trigauser
SupplementaryGroups=dialout

[Install]
WantedBy=multi-user.target
